{
  "openapi": "3.0.3",
  "info": {
    "title": "Runtime UI Demo API",
    "description": "运行界面 ↔ Python demo 的语言中立 JSON 契约（ADR-0003 第二条边界）。TS 侧（web/src/api/contract.ts）的类型由此文档推导；Python 侧按此形状实现 HTTP 端点。",
    "version": "0.1.0"
  },
  "paths": {
    "/demo/{demoId}/chat": {
      "post": {
        "summary": "向运行中的 demo 发消息并取回复",
        "parameters": [
          {
            "name": "demoId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "agent 回复",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatReply" }
              }
            }
          }
        }
      }
    },
    "/demo/{demoId}/telemetry": {
      "get": {
        "summary": "获取 demo 的组件粒度遥测数据",
        "parameters": [
          {
            "name": "demoId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "遥测 span 列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TelemetryResponse" }
              }
            }
          }
        }
      }
    },
    "/demo/{demoId}/ablations": {
      "post": {
        "summary": "触发一次消融跑",
        "parameters": [
          {
            "name": "demoId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AblationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "消融跑结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AblationResponse" }
              }
            }
          }
        }
      }
    },
    "/demo/{demoId}/generate": {
      "post": {
        "summary": "用配方生成 demo 并运行（接线引擎入口）",
        "parameters": [
          {
            "name": "demoId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GenerateDemoRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "demo 生成结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenerateDemoResponse" }
              }
            }
          }
        }
      }
    },
    "/config": {
      "get": {
        "summary": "读取运行环境配置（api key 掩码回显，完整值不出 server）",
        "responses": {
          "200": {
            "description": "运行环境配置视图",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RuntimeConfig" }
              }
            }
          }
        }
      },
      "put": {
        "summary": "保存运行环境配置（持久化到 server/config.json）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RuntimeConfigUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "保存后的运行环境配置视图（api key 掩码回显）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RuntimeConfig" }
              }
            }
          }
        }
      }
    },
    "/components": {
      "get": {
        "summary": "列出注册组件契约（id/version/role/description/inputs/outputs/params）",
        "responses": {
          "200": {
            "description": "组件契约清单",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ComponentsResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRole": {
        "type": "string",
        "enum": ["user", "assistant", "system"]
      },
      "ChatMessage": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "$ref": "#/components/schemas/ChatRole" },
          "content": { "type": "string" }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": ["messages"],
        "properties": {
          "messages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChatMessage" }
          }
        }
      },
      "ChatReply": {
        "type": "object",
        "required": ["reply"],
        "properties": {
          "reply": { "$ref": "#/components/schemas/ChatMessage" }
        }
      },
      "TokenUsage": {
        "type": "object",
        "required": ["input", "output"],
        "properties": {
          "input": { "type": "number" },
          "output": { "type": "number" }
        }
      },
      "TelemetrySpan": {
        "type": "object",
        "required": [
          "id",
          "componentId",
          "operation",
          "startTimeMs",
          "durationMs",
          "tokenUsage",
          "status"
        ],
        "properties": {
          "id": { "type": "string" },
          "componentId": { "type": "string" },
          "operation": { "type": "string" },
          "startTimeMs": { "type": "number" },
          "durationMs": { "type": "number" },
          "tokenUsage": {
            "anyOf": [
              { "$ref": "#/components/schemas/TokenUsage" },
              { "type": "null" }
            ]
          },
          "status": {
            "type": "string",
            "enum": ["ok", "error"]
          }
        }
      },
      "TelemetryResponse": {
        "type": "object",
        "required": ["spans"],
        "properties": {
          "spans": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TelemetrySpan" }
          }
        }
      },
      "AblationKind": {
        "type": "string",
        "enum": ["swap", "remove", "override"]
      },
      "AblationVariant": {
        "type": "object",
        "required": ["kind", "target"],
        "properties": {
          "kind": { "$ref": "#/components/schemas/AblationKind" },
          "target": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "AblationRequest": {
        "type": "object",
        "required": ["variant"],
        "properties": {
          "variant": { "$ref": "#/components/schemas/AblationVariant" }
        }
      },
      "AblationResult": {
        "type": "object",
        "required": ["variant", "scores", "spans"],
        "properties": {
          "variant": { "$ref": "#/components/schemas/AblationVariant" },
          "scores": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "spans": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TelemetrySpan" }
          }
        }
      },
      "AblationRun": {
        "type": "object",
        "required": ["runId", "status", "results"],
        "properties": {
          "runId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "running", "done", "failed"]
          },
          "results": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AblationResult" }
          }
        }
      },
      "AblationResponse": {
        "type": "object",
        "required": ["run"],
        "properties": {
          "run": { "$ref": "#/components/schemas/AblationRun" }
        }
      },
      "ComponentReference": {
        "type": "object",
        "required": ["id", "version"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "Connection": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      },
      "Recipe": {
        "description": "配方结构。权威单一来源是 contracts/recipe-schema.json（与 assembler/Python 侧共享）；本处为 OpenAPI 内联副本，须与之一致，见 tests/test_openapi_recipe_sync.py。",
        "type": "object",
        "required": ["components", "connections", "parameters"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "components": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ComponentReference" }
          },
          "connections": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Connection" }
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "GenerateDemoRequest": {
        "type": "object",
        "required": ["recipe"],
        "properties": {
          "recipe": { "$ref": "#/components/schemas/Recipe" }
        }
      },
      "GenerateDemoResponse": {
        "type": "object",
        "required": ["demoId", "status"],
        "properties": {
          "demoId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["accepted", "running", "done", "failed"]
          },
          "message": { "type": "string" }
        }
      },
      "RuntimeConfig": {
        "type": "object",
        "description": "运行环境配置视图。apiKey 只做掩码回显（如 sk-***abc），完整值不进前端 DOM。",
        "required": ["apiKey", "baseUrl", "componentParams"],
        "properties": {
          "apiKey": { "type": "string" },
          "baseUrl": { "type": "string" },
          "componentParams": {
            "type": "object",
            "description": "组件级默认参数：组件 id → 参数名 → 值。生成 demo 时配方缺省的参数回退到这里。",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "RuntimeConfigUpdate": {
        "type": "object",
        "description": "PUT /config 请求体。apiKey 传掩码占位值（含 ***）表示未改动，不覆盖真实 key。",
        "properties": {
          "apiKey": { "type": "string" },
          "baseUrl": { "type": "string" },
          "componentParams": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "ComponentPort": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" }
        }
      },
      "ComponentParamSpec": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "default": {},
          "enum": {
            "type": "array",
            "items": {}
          },
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      },
      "ComponentInfo": {
        "type": "object",
        "required": ["id", "version", "role", "description", "inputs", "outputs", "params"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "role": { "type": "string" },
          "description": { "type": "string" },
          "inputs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ComponentPort" }
          },
          "outputs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ComponentPort" }
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ComponentParamSpec"
            }
          }
        }
      },
      "ComponentsResponse": {
        "type": "object",
        "required": ["components"],
        "properties": {
          "components": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ComponentInfo" }
          }
        }
      }
    }
  }
}
